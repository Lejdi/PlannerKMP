    <string name="tasks_delete_confirm_title">Delete this task?</string>
    <string name="tasks_delete_confirm_body">This cannot be undone.</string>

    <!-- Spoken by a screen reader on a field that opens a picker rather than a keyboard. -->
    <!-- The value only. The gesture is the assistive service's to describe, not ours: TalkBack
         appends its own hint for a Button, so spelling out "double tap" said it twice and said the
         wrong thing entirely for Switch Access, a braille display or a keyboard. -->
    <string name="tasks_a11y_pick_date">%1$s, %2$s</string>
    <string name="tasks_a11y_pick_time">%1$s, %2$s</string>
    <!-- Action labels, announced by each service in its own words ("double tap to …", "press Enter to …"). -->
    <string name="tasks_a11y_action_choose_date">choose a date</string>
    <string name="tasks_a11y_action_choose_time">choose a time</string>
